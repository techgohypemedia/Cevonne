    {
      "parameters": {
        "jsCode": "\n// Extract message details from Meta WhatsApp webhook or manual payload\nconst body = $input.first().json.body || $input.first().json || {};\n\nlet phone = null;\nlet messageText = '';\nlet isOptOut = false;\n\n// 1. Direct API / Test format: { phone: '...', keyword: 'STOP' }\nif (body.phone) {\n  phone = String(body.phone).replace(/[^0-9]/g, '');\n  messageText = String(body.keyword || body.message || 'STOP').trim();\n}\n\n// 2. Meta WhatsApp Inbound Webhook format\ntry {\n  const entry = body.entry?.[0];\n  const change = entry?.changes?.[0]?.value;\n  const message = change?.messages?.[0];\n  if (message) {\n    phone = String(message.from || '').replace(/[^0-9]/g, '');\n    messageText = String(message.text?.body || '').trim();\n  }\n} catch (e) {}\n\nconst normalized = messageText.toUpperCase();\nconst optOutKeywords = ['STOP', 'UNSUBSCRIBE', 'CANCEL', 'OPTOUT', 'STOPALL'];\nisOptOut = optOutKeywords.some(k => normalized === k || normalized.startsWith(k + ' '));\n\nreturn [{\n  json: {\n    is_opt_out: isOptOut,\n    phone: phone,\n    keyword: messageText,\n    received_at: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "44444444-dddd-4444-8444-444444444444",
